{
  "name": "@vanilla-ts/components",
  "description": "TypeScript Web UI Library -- Components",
  "companyname": "mn4367",
  "version": "0.0.1",
  "copyright": "©2026 mn4367",
  "type": "module",
  "identifier": "mn4367.vanilla-ts.components",
  "keywords": [
    "typescript",
    "web",
    "ui",
    "library",
    "dom",
    "component"
  ],
  "homepage": "https://github.com/mn4367/vanilla-ts-components",
  "author": {
    "name": "mn4367",
    "email": "mn@mn4367.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mn4367/vanilla-ts-components.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/mn4367/vanilla-ts-components/issues"
  },
  "private": "false",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "dependencies": {
    "@vanilla-ts/core": "file:../vanilla-ts-core",
    "@vanilla-ts/dom": "file:../vanilla-ts-dom"
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "npm-run-all2": "8.0.4",
    "onchange": "7.1.0",
    "rollup": "4.60.2",
    "shx": "0.4.0",
    "terser": "5.46.1",
    "tsc-watch": "7.2.0",
    "typescript-eslint": "8.59.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Watch": "npm-run-all -p watch:**",
    "Clean": "shx rm -rf ./types ./lib ./example/out ./example/index.js* ./playground/out ./playground/index.js*",
    "watch:src": "tsc -w -p ./src/tsconfig.src.json",
    "watch:example": "tsc-watch -p ./example/src/tsconfig.example.json    --onSuccess \"npm-run-all -p pack:example pack:example:css\"",
    "watch:example:css": "onchange './example/src/style/**' './themes/**' -v --await-write-finish 500 -- npm run pack:example:css",
    "watch:playground": "tsc-watch -p ./playground/src/tsconfig.playground.json --onSuccess \"npm-run-all -p pack:playground pack:playground:css\"",
    "watch:playground:css": "onchange './playground/src/style/**' './themes/**' -v --await-write-finish 500 -- npm run pack:playground:css",
    "compile:src": "tsc -p ./src/tsconfig.src.json",
    "compile:example": "tsc -p ./example/src/tsconfig.example.json",
    "compile:playground": "tsc -p ./playground/src/tsconfig.playground.json",
    "pack:example": "rollup --silent -c ./example/build/rollup.config.example.mjs",
    "pack:example:css": "node ./example/build/concat-css-files.js ./example/style.css",
    "pack:example:compress": "rollup --silent -c ./example/build/rollup.config.example.mjs --environment COMPRESS",
    "pack:playground": "rollup --silent -c ./playground/build/rollup.config.playground.mjs",
    "pack:playground:css": "node ./playground/build/concat-css-files.js ./playground/style/style.css",
    "pack:playground:compress": "rollup --silent -c ./playground/build/rollup.config.playground.mjs --environment COMPRESS",
    "lint": "eslint -c ./eslint.config.mjs"
  }
}
