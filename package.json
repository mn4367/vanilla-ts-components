{
  "name": "@vanilla-ts/components",
  "description": "TypeScript Web UI Library -- Components",
  "companyname": "mn4367",
  "copyright": "©2025 mn4367",
  "version": "0.0.9",
  "type": "module",
  "identifier": "mn4367.vanilla-ts.components",
  "keywords": [
    "typescript",
    "web",
    "ui",
    "library",
    "dom",
    "component"
  ],
  "homepage": "https://github.com/mn4367/vanilla-ts-components",
  "author": {
    "name": "mn4367",
    "email": "mn@mn4367.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mn4367/vanilla-ts-components.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/mn4367/vanilla-ts-components/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "types": "./types/index.d.ts"
    },
    "./pdf-load": {
      "import": "./lib/viewer-items/PDFLoad.js",
      "types": "./types/viewer-items/PDFLoad.d.ts"
    },
    "./pdf-load-legacy": {
      "import": "./lib/viewer-items/PDFLoad_legacy.js",
      "types": "./types/viewer-items/PDFLoad_legacy.d.ts"
    },
    "./pdf-canvas-items": {
      "import": "./lib/viewer-items/PDFCanvasItems.js",
      "types": "./types/viewer-items/PDFCanvasItems.d.ts"
    },
    "./viewer-item-canvas": {
      "import": "./lib/viewer-items/ViewerItemCanvas.js",
      "types": "./types/viewer-items/ViewerItemCanvas.d.ts"
    },
    "./viewer-item-components": {
      "import": "./lib/viewer-items/ViewerItemComponents.js",
      "types": "./types/viewer-items/ViewerItemComponents.d.ts"
    },
    "./viewer-item-image": {
      "import": "./lib/viewer-items/ViewerItemImage.js",
      "types": "./types/viewer-items/ViewerItemImage.d.ts"
    }
  },
  "dependencies": {
    "@vanilla-ts/core": "0.0.1",
    "@vanilla-ts/dom": "0.0.1",
    "pdfjs-dist": "6.1.200"
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "eslint-plugin-jsdoc": "48.8.3",
    "eslint": "8.57.0",
    "npm-run-all": "4.1.5",
    "rollup": "4.50.1",
    "shx": "0.4.0",
    "terser": "5.44.0",
    "tsc-watch": "7.1.1",
    "typescript": "5.9.2"
  },
  "scripts": {
    "Watch": "npm-run-all -p watch:**",
    "Clean": "shx rm -rf ./types ./lib ./example/out ./example/index.js*",
    "Publish": "npm-run-all -s Clean compile:src && npm publish",
    "watch:src": "tsc-watch -p ./src/tsconfig.src.json --onSuccess \"npm run pack:pdf-js:src\"",
    "watch:example": "tsc-watch -p ./example/tsconfig.example.json --onSuccess \"npm-run-all pack:pdf-js:example pack:example\"",
    "compile:src": "tsc -p ./src/tsconfig.src.json && npm run pack:pdf-js:src",
    "compile:example": "tsc -p ./example/tsconfig.example.json && npm run pack:pdf-js:example",
    "pack:example": "rollup --silent -c ./build/rollup.config.example.mjs",
    "pack:example:compress": "rollup --silent -c ./build/rollup.config.example.mjs --environment COMPRESS",
    "pack:pdf-js:src": "node ./build/pack.pdf-js.js ./lib/viewer-items",
    "pack:pdf-js:example": "node ./build/pack.pdf-js.js ./example/out/src/viewer-items",
    "lint": "eslint -c ./eslintrc.json --parser-options=project:./tsconfig.json --ext .ts ."
  },
  "files": [
    "build",
    "lib",
    "src",
    "themes",
    "types"
  ]
}
